# ExploreMe AI Backend Environment Variables Example
APP_NAME="ExploreMe AI"
APP_ENV="development"
DEBUG=true
API_V1_STR="/api/v1"

# IMPORTANT: Generate a strong random secret for production (min 32 chars).
# The placeholder below is REJECTED when APP_ENV=production.
SECRET_KEY="super-secret-key-change-in-production-min-32-chars-long"

# Database Configuration (MongoDB Atlas)
MONGODB_URL="mongodb+srv://user:password@cluster.mongodb.net/?appName=exploreme"
MONGODB_DB_NAME="exploreme_ai_db"

# AI Provider Configuration (Groq Live Key)
GROQ_API_KEY=your_groq_api_key_here
DEFAULT_AI_PROVIDER=groq

# Email Configuration (Resend)
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=noreply@example.com
FRONTEND_URL=http://localhost:5173

# Cloudinary Media Storage Credentials
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Razorpay Payment Gateway (Golden Membership ₹69/month)
# Get credentials from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID="your_razorpay_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET=""
# Optional: Manually set a Razorpay Plan ID (auto-created if empty)
RAZORPAY_PLAN_ID=""

# Google Authentication
GOOGLE_CLIENT_ID="your_google_client_id_here"

# Allowed Origins for CORS (Comma Separated)
ALLOWED_ORIGINS="http://localhost:5173,https://exploreme.ai,https://exploreme-ai.vercel.app"
